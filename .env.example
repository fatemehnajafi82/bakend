# این فایل را به .env کپی کن و مقادیر را عوض کن. فایل .env را هرگز در گیت نگذار.

# ---- توسعه (روی سیستم خودت) ----
DJANGO_DEBUG=True

# ---- محیط واقعی (DEBUG=False) ----
# کلید تصادفی بساز: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# DJANGO_BEHIND_PROXY=True        # اگر پشت Nginx/Load balancer با HTTPS هستی

# ---- دیتابیس (پیش‌فرض SQLite؛ برای Postgres این‌ها را باز کن) ----
# POSTGRES_DB=hamava
# POSTGRES_USER=hamava
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost

# ---- کش (پیشنهاد برای محیط واقعی) ----
# REDIS_URL=redis://localhost:6379/1

# ---- ایمیل (اگر خالی باشد، ایمیل‌ها فقط در کنسول چاپ می‌شوند) ----
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Hamava <you@example.com>

# ---- محدودیت‌ها (اختیاری) ----
# THROTTLE_OTP=10/hour
# LOG_LEVEL=INFO
